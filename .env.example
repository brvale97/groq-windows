GROQ_API_KEY=

# Fast and multilingual. Use whisper-large-v3 if you want maximum accuracy.
GROQ_MODEL=whisper-large-v3-turbo

# Optional. For Dutch: nl. You can also leave it empty to let Whisper detect the language.
GROQ_LANGUAGE=nl

# Optional. Helps with names/terms/spelling; at most about 224 tokens.
GROQ_PROMPT=

# Default: Insert starts/stops.
DICTATION_SHORTCUT=insert

# Optional. Set to a device index from the startup list, for example 11.
DICTATION_INPUT_DEVICE=

# 16 kHz mono WAV is fast and suits Groq STT.
DICTATION_SAMPLE_RATE=16000
DICTATION_CHANNELS=1

# Set to false if you only want the clipboard backup without automatic pasting.
PASTE_AFTER_TRANSCRIPTION=true
